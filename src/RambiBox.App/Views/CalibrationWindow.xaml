<Window x:Class="RambiBox.App.Views.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RambiBox.App.Views"
        Title="RambiBox – color calibration" WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        Background="Black" WindowStartupLocation="Manual" ShowActivated="True"
        Icon="/Assets/RambiBox.ico" ThemeMode="Dark" Width="800" Height="450">
    <Grid x:Name="Root" Background="Black" SnapsToDevicePixels="True" UseLayoutRounding="True">
        <!-- the measurement / eye pattern (one element, drawn pixel-exact) -->
        <local:PatternSurface x:Name="Surface" IsHitTestVisible="False" />

        <!-- QR code inside Pattern.QrArea -->
        <Canvas x:Name="QrCanvas">
            <StackPanel x:Name="QrPanel" Visibility="Collapsed">
                <TextBlock x:Name="QrTitle" Text="Scan with your phone camera" Foreground="White" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <Border x:Name="QrBorder" Background="White" HorizontalAlignment="Center" CornerRadius="6" Margin="0,10,0,8">
                    <Image x:Name="QrImage" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Fill"
                           AutomationProperties.Name="QR code with the calibration link" />
                </Border>
                <TextBlock x:Name="UrlText" Foreground="#9A9A9A" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" FontSize="13" />
            </StackPanel>
        </Canvas>

        <!-- status: camera patterns → between the top band and the black probe; eye patterns → centre -->
        <StackPanel x:Name="StatusPanel" HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="900">
            <TextBlock x:Name="StatusText" Foreground="#C8C8C8" FontSize="20" TextAlignment="Center" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="DetailText" Foreground="#7A7A7A" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
            <Border x:Name="ProgressTrack" Height="3" Background="#262626" Margin="0,8,0,0" CornerRadius="1.5" Visibility="Collapsed">
                <Border x:Name="ProgressFill" HorizontalAlignment="Left" Background="#6A6A6A" CornerRadius="1.5" Width="0" />
            </Border>
            <TextBlock x:Name="HintText" Foreground="#8A8A8A" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="If your phone can't open the page, allow RambiBox in the Windows Firewall prompt (Private networks) and make sure the phone is on the same Wi-Fi." />
        </StackPanel>

        <!-- buttons: above the bottom band, below the step-code row -->
        <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="120" Margin="0,0,12,0" Click="OnCancel" IsCancel="True"
                    ToolTip="Stop and restore the previous colors (Esc)." />
            <Button x:Name="DoneButton" Content="Done" MinWidth="120" Click="OnDone" Style="{DynamicResource AccentButtonStyle}"
                    ToolTip="Stop and keep the new colors." />
        </StackPanel>
    </Grid>
</Window>
