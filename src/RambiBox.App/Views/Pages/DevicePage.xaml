<UserControl x:Class="RambiBox.App.Views.Pages.DevicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RambiBox.App.Controls"
             IsTabStop="False">
    <StackPanel>
        <TextBlock Text="Device" Style="{StaticResource PageTitle}" />
        <TextBlock Text="Your Adalight-compatible LED controller. RambiBox finds it automatically – also when you plug it into another USB port."
                   Style="{StaticResource PageSubtitle}" />

        <!-- status -->
        <Border Style="{StaticResource Card}" Padding="20,18">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" CornerRadius="24" VerticalAlignment="Top" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <TextBlock Text="&#xE88E;" Style="{StaticResource IconText}" FontSize="22" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDot}" Margin="0,2,10,0" />
                            <TextBlock Text="{Binding DeviceTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding DeviceDescription}" Style="{StaticResource SettingDescription}" FontSize="14" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource SettingDescription}" />
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource Divider}" Margin="-20,14" />
                <UniformGrid Columns="4">
                    <StackPanel Margin="0,0,12,0" ToolTip="The most updates per second the serial link can carry for your number of LEDs and baud rate.">
                        <TextBlock Text="Link limit" Style="{StaticResource SettingDescription}" />
                        <TextBlock Text="{Binding LinkFpsText}" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0" ToolTip="Updates actually sent to the LEDs per second. It drops when nothing on screen changes.">
                        <TextBlock Text="Sending" Style="{StaticResource SettingDescription}" />
                        <TextBlock Text="{Binding OutputFpsText}" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0" ToolTip="How often the screen is captured and how long one capture takes.">
                        <TextBlock Text="Screen capture" Style="{StaticResource SettingDescription}" />
                        <TextBlock Text="{Binding CaptureText}" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel ToolTip="The monitor being captured.">
                        <TextBlock Text="Monitor" Style="{StaticResource SettingDescription}" />
                        <TextBlock Text="{Binding MonitorText}" FontSize="16" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <c:SettingCard Header="Test colors" Glyph="&#xE790;" Margin="0,4,0,0"
                       Description="Shows red, green, blue and white in turn, to check the wiring and the color order.">
            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding TestColors}" AutomationProperties.Name="Test colors"
                      IsEnabled="{Binding CalibrationActive, Converter={StaticResource InverseBool}}" />
        </c:SettingCard>

        <TextBlock Text="Connection" Style="{StaticResource SectionHeader}" />
        <c:SettingCard Header="Port" Glyph="&#xE88E;"
                       Description="Automatic finds the controller on any USB port. Choose a port only if detection fails.">
            <ComboBox MinWidth="260" MaxWidth="360" ItemsSource="{Binding PortOptions}" DisplayMemberPath="Display"
                      SelectedValuePath="Value" SelectedValue="{Binding S.Port}" AutomationProperties.Name="Port" />
        </c:SettingCard>
        <c:SettingCard Header="Baud rate" Glyph="&#xE9D9;"
                       Description="Speed of the serial link. Must match your controller's firmware (115200 for most Adalight sketches).">
            <ComboBox Width="160" IsEditable="True" ItemsSource="{Binding BaudRates}"
                      Text="{Binding S.BaudRateText, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Baud rate" />
        </c:SettingCard>
        <c:SettingCard Header="Color order" Glyph="&#xE8B1;"
                       Description="Change this if red, green or blue appear swapped on the strip (check with Test colors).">
            <ComboBox Width="160" ItemsSource="{Binding ColorOrders}" DisplayMemberPath="Display" SelectedValuePath="Value"
                      SelectedValue="{Binding S.ColorOrder}" AutomationProperties.Name="Color order" />
        </c:SettingCard>
        <c:SettingCard Header="Maximum update rate" Glyph="&#xEC4A;"
                       Description="Automatic sends updates as fast as the USB link allows, for the lowest delay.">
            <ComboBox MinWidth="200" MaxWidth="360" ItemsSource="{Binding FpsOptions}" DisplayMemberPath="Display"
                      SelectedValuePath="Value" SelectedValue="{Binding S.MaxFps}" AutomationProperties.Name="Maximum update rate" />
        </c:SettingCard>

        <TextBlock Text="Log" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBox x:Name="LogBox" IsReadOnly="True" Height="220" TextWrapping="NoWrap"
                         FontFamily="{StaticResource MonoFont}" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Recent log lines" />
                <WrapPanel Margin="0,10,0,0">
                    <Button Command="{Binding OpenLogFolderCommand}" Margin="0,0,8,0" AutomationProperties.Name="Open log folder">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Open log folder" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
