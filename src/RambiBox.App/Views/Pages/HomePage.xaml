<UserControl x:Class="RambiBox.App.Views.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RambiBox.App.Controls"
             IsTabStop="False">
    <StackPanel>
        <TextBlock Text="Home" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />

        <!-- master switch + status -->
        <Border Style="{StaticResource Card}" Padding="20,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="24" VerticalAlignment="Top"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <TextBlock Text="&#xE7E8;" Style="{StaticResource IconText}" FontSize="22" HorizontalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="18,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Lights" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Style="{StaticResource StatusDot}" Width="8" Height="8" Margin="0,1,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="14" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                    <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource SettingDescription}" Margin="16,2,0,0"
                               Visibility="{Binding StatusDetail, Converter={StaticResource NullToCollapsed}}" />
                    <Button Content="{Binding CloseAmbiBoxLabel}" Command="{Binding CloseAmbiBoxCommand}" Margin="16,10,0,0"
                            HorizontalAlignment="Left" Style="{DynamicResource AccentButtonStyle}"
                            Visibility="{Binding ShowCloseAmbiBoxInStatus, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding S.Enabled}"
                          AutomationProperties.Name="Lights on" ToolTip="Master switch: turns the LEDs on or off." />
            </Grid>
        </Border>

        <!-- live preview -->
        <Border Style="{StaticResource Card}" Padding="12" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="Live preview" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="6,0,0,2" />
                <c:LedPreview x:Name="Preview" Height="320" AutomationProperties.Name="Live preview of the screen and the LEDs" />
            </StackPanel>
        </Border>

        <!-- mode -->
        <TextBlock Text="Mode" Style="{StaticResource SectionHeader}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <RadioButton Style="{StaticResource ChoiceCard}" GroupName="Mode" IsChecked="{Binding S.IsAmbilight}"
                         AutomationProperties.Name="Screen ambilight">
                <StackPanel>
                    <TextBlock Text="&#xE7F4;" Style="{StaticResource IconText}" FontSize="22" HorizontalAlignment="Left" />
                    <TextBlock Text="Screen ambilight" Style="{StaticResource SettingTitle}" FontWeight="SemiBold" Margin="0,10,0,0" />
                    <TextBlock Text="The LEDs follow the colors at the edges of your screen." Style="{StaticResource SettingDescription}" />
                </StackPanel>
            </RadioButton>
            <RadioButton Grid.Column="2" Style="{StaticResource ChoiceCard}" GroupName="Mode" IsChecked="{Binding S.IsStaticColor}"
                         AutomationProperties.Name="Static color">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="&#xEA80;" Style="{StaticResource IconText}" FontSize="22" HorizontalAlignment="Left" />
                        <Border x:Name="StaticSwatch" Width="22" Height="22" CornerRadius="11" HorizontalAlignment="Right"
                                BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
                    </Grid>
                    <TextBlock Text="Static color" Style="{StaticResource SettingTitle}" FontWeight="SemiBold" Margin="0,10,0,0" />
                    <TextBlock Style="{StaticResource SettingDescription}">
                        <Run Text="One fixed color, e.g. warm white for the room." />
                        <Hyperlink Command="{Binding NavigateCommand}" CommandParameter="static">Choose color</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </RadioButton>
            <RadioButton Grid.Column="4" Style="{StaticResource ChoiceCard}" GroupName="Mode" IsChecked="{Binding S.IsMood}"
                         AutomationProperties.Name="Mood light">
                <StackPanel>
                    <TextBlock Text="&#xE790;" Style="{StaticResource IconText}" FontSize="22" HorizontalAlignment="Left" />
                    <TextBlock Text="Mood light" Style="{StaticResource SettingTitle}" FontWeight="SemiBold" Margin="0,10,0,0" />
                    <TextBlock Style="{StaticResource SettingDescription}">
                        <Run Text="Slowly changing colors: color cycle, rainbow or breathing." />
                        <Hyperlink Command="{Binding NavigateCommand}" CommandParameter="static">Effects</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </RadioButton>
        </Grid>

        <!-- brightness -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <c:SettingSlider Header="Brightness" Description="Overall brightness of the LEDs in every mode."
                             Minimum="0" Maximum="100" Step="1" LargeChange="10" ValueFormat="{}{0:0}%" DefaultValue="100"
                             Value="{Binding S.Brightness}" />
        </Border>
    </StackPanel>
</UserControl>
