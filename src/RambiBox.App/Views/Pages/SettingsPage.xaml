<UserControl x:Class="RambiBox.App.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RambiBox.App.Controls"
             xmlns:app="clr-namespace:RambiBox.App"
             IsTabStop="False">
    <StackPanel>
        <TextBlock Text="Settings" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />

        <TextBlock Text="Startup and power" Style="{StaticResource SectionHeader}" Margin="2,0,0,8" />
        <c:SettingCard Header="Start with Windows" Glyph="&#xE7E8;"
                       Description="RambiBox starts quietly in the notification area when you sign in.">
            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding S.StartWithWindows}" AutomationProperties.Name="Start with Windows" />
        </c:SettingCard>
        <c:SettingCard Header="Turn off the LEDs when the display turns off" Glyph="&#xE7F4;"
                       Description="The LEDs go dark when Windows switches the screen off, and come back with it. (They always turn off when the PC sleeps or shuts down.)">
            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding S.OffWhenDisplayOff}" AutomationProperties.Name="Turn off the LEDs when the display turns off" />
        </c:SettingCard>
        <c:SettingCard Header="Turn off the LEDs when the PC is locked" Glyph="&#xE72E;"
                       Description="The LEDs go dark on the lock screen (Windows key + L) and come back when you sign in.">
            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding S.OffWhenLocked}" AutomationProperties.Name="Turn off the LEDs when the PC is locked" />
        </c:SettingCard>

        <TextBlock Text="Screen capture" Style="{StaticResource SectionHeader}" />
        <c:SettingCard Header="Capture method" Glyph="&#xE722;"
                       Description="Windows Graphics Capture (recommended) — Desktop Duplication can make Chromium browsers stutter on some systems.">
            <StackPanel>
                <ComboBox MinWidth="240" MaxWidth="320" ItemsSource="{Binding CaptureMethods}" DisplayMemberPath="Display"
                          SelectedValuePath="Value" SelectedValue="{Binding S.CaptureMethod}" AutomationProperties.Name="Capture method" />
                <TextBlock Text="{Binding CaptureMethodStatus}" Style="{StaticResource SettingDescription}" Margin="2,6,0,0"
                           MaxWidth="320" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </c:SettingCard>
        <c:SettingCard Header="Ignore black bars (letterbox)" Glyph="&#xE740;"
                       Description="For films with black bars, the LEDs use the colors of the picture instead of the bars.">
            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding S.BlackBarDetection}" AutomationProperties.Name="Ignore black bars" />
        </c:SettingCard>

        <TextBlock Text="Prismatik API (for integrations)" Style="{StaticResource SectionHeader}" />
        <c:SettingCard Header="Prismatik API server" Glyph="&#xE943;"
                       Description="Lets tools made for Prismatik / Lightpack control RambiBox: Home Assistant (Prismatik integration), the Python “lightpack” library, Stream Deck plugins and scripts.">
            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding S.ApiEnabled}" AutomationProperties.Name="Prismatik API server" />
        </c:SettingCard>
        <c:SettingCard Header="Port" Glyph="&#xE839;"
                       Description="Prismatik's default is 3636. Use the same port in the integration.">
            <TextBox Width="96" TextAlignment="Center" VerticalContentAlignment="Center"
                     Text="{Binding S.ApiPortText, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="API port" />
        </c:SettingCard>
        <c:SettingCard Header="Allow other devices on the network" Glyph="&#xE774;"
                       Description="Off: only programs on this PC can connect (127.0.0.1). On: devices on your home network (private addresses only) can connect, e.g. Home Assistant. Windows may ask to allow RambiBox in the firewall.">
            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding S.ApiAllowLan}" AutomationProperties.Name="Allow other devices on the network" />
        </c:SettingCard>
        <c:SettingCard Header="API key" Glyph="&#xE8D7;"
                       Description="Optional password. Clients must send it first (the “API key” field of the integration). Leave empty for none.">
            <WrapPanel HorizontalAlignment="Right">
                <TextBox Width="250" FontFamily="{StaticResource MonoFont}" VerticalContentAlignment="Center" Margin="0,0,8,4"
                         Text="{Binding S.ApiKey, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="API key" />
                <Button Content="Generate" Command="{Binding S.GenerateApiKeyCommand}" Margin="0,0,8,4" />
                <Button Command="{Binding S.CopyApiKeyCommand}" Margin="0,0,0,4" ToolTip="Copy the key" AutomationProperties.Name="Copy the API key">
                    <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" />
                </Button>
            </WrapPanel>
        </c:SettingCard>
        <c:InfoBar Severity="Warning" Title="Set an API key" Margin="0,4,0,4"
                   Message="Other devices on your network can connect. Generate a key and enter it in the integration so only they can control the LEDs."
                   Visibility="{Binding S.ApiKeyHintVisible, Converter={StaticResource BoolToVisibility}}" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" AutomationProperties.LiveSetting="Polite">
                    <Run Text="Status:" FontWeight="SemiBold" /> <Run Text="{Binding S.ApiStatusText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource SettingDescription}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Speaks the Prismatik API 2.2 (Lightpack API 1.4): lock, setcolor, setbrightness, setsmooth, setstatus, setmode and the get commands. While an integration holds the lock, its colors are shown (through your white balance) and Home says “Controlled by an integration”; the LEDs return to normal when it unlocks or disconnects." />
            </StackPanel>
        </Border>

        <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}" />
        <c:SettingCard Header="Theme" Glyph="&#xE790;"
                       Description="RambiBox follows your Windows light or dark mode and accent color automatically. Change them in Windows Settings › Personalization." />

        <TextBlock Text="AmbiBox" Style="{StaticResource SectionHeader}" />
        <c:SettingCard x:Name="ImportCard" Header="Import settings from AmbiBox" Glyph="&#xE8B5;"
                       Description="Replaces all RambiBox settings with your current AmbiBox profile (LEDs, colors, white balance, port).">
            <Button x:Name="ImportButton" Content="Import…" Click="OnImport" />
        </c:SettingCard>
        <c:SettingCard Header="AmbiBox at startup" Glyph="&#xE7E8;" x:Name="AutostartCard"
                       Description="Whether AmbiBox still starts with Windows. Only one program can use the LED controller.">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="AutostartText" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Button Content="Remove from startup" Command="{Binding RemoveAmbiBoxAutostartCommand}"
                        Visibility="{Binding AmbiBoxInAutostart, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </c:SettingCard>

        <TextBlock Text="Reset" Style="{StaticResource SectionHeader}" />
        <c:SettingCard Header="Reset all settings" Glyph="&#xE777;"
                       Description="Goes back to the default settings. Your AmbiBox settings are imported again if AmbiBox is installed.">
            <Button x:Name="ResetButton" Content="Reset…" Click="OnResetClick" />
        </c:SettingCard>
        <c:InfoBar x:Name="ResetConfirm" Severity="Warning" Title="Reset all settings?" Visibility="Collapsed"
                   Message="Layout, colors, white balance and device settings are replaced. This can't be undone." Margin="0,4,0,4">
            <WrapPanel>
                <Button Content="Reset all settings" Style="{DynamicResource AccentButtonStyle}" Click="OnResetConfirmed" Margin="0,0,8,0" />
                <Button Content="Cancel" Click="OnResetCancelled" />
            </WrapPanel>
        </c:InfoBar>

        <TextBlock x:Name="AboutHeader" Text="About &amp; updates" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/RambiBox.ico" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Updates.VersionTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       AutomationProperties.Name="Version" />
                            <Border Style="{StaticResource Badge}" Margin="10,1,0,0" ToolTip="Which releases RambiBox offers as updates (change it below)">
                                <TextBlock Text="{Binding Updates.ChannelBadge}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Updates.BuildText}" Style="{StaticResource SettingDescription}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Style="{StaticResource SettingDescription}" Margin="0,12,0,0" Text="Ambient lighting for Adalight LED strips – the successor of AmbiBox for Windows 11." />
                <TextBlock Style="{StaticResource SettingDescription}" Margin="0,4,0,0" TextWrapping="Wrap">
                    <Run Text="{Binding LicenseText, Mode=OneWay}" />
                    <Hyperlink Command="{Binding OpenUrlCommand}" CommandParameter="{x:Static app:AppInfo.LicenseUrl}"
                               ToolTip="{x:Static app:AppInfo.LicenseUrl}">License</Hyperlink>
                </TextBlock>
                <WrapPanel Margin="0,12,0,0">
                    <Button Command="{Binding OpenUrlCommand}" CommandParameter="{x:Static app:AppInfo.RepoUrl}" Margin="0,0,8,4"
                            ToolTip="{x:Static app:AppInfo.RepoUrl}" AutomationProperties.Name="Open the GitHub repository">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE943;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="GitHub" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenUrlCommand}" CommandParameter="{x:Static app:AppInfo.SiteUrl}" Margin="0,0,8,4"
                            ToolTip="{x:Static app:AppInfo.SiteUrl}" AutomationProperties.Name="Open the website">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Website" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenUrlCommand}" CommandParameter="{x:Static app:AppInfo.IssuesUrl}" Margin="0,0,8,4"
                            ToolTip="{x:Static app:AppInfo.IssuesUrl}" AutomationProperties.Name="Report an issue">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEBE8;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Report an issue" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <Border Style="{StaticResource Divider}" Margin="-16,12" />
                <TextBlock Style="{StaticResource SettingDescription}">
                    <Run Text="Settings:" /> <Run Text="{Binding SettingsPath, Mode=OneWay}" />
                    <Hyperlink Command="{Binding OpenSettingsFolderCommand}">Open folder</Hyperlink>
                </TextBlock>
                <TextBlock Style="{StaticResource SettingDescription}" Margin="0,4,0,0">
                    <Run Text="Log:" /> <Run Text="{Binding LogPath, Mode=OneWay}" />
                    <Hyperlink Command="{Binding OpenLogFolderCommand}">Open folder</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- updates: status + actions -->
        <Border x:Name="UpdatesCard" Style="{StaticResource Card}" Margin="0,8,0,4" DataContext="{Binding Updates}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="40" Height="40" VerticalAlignment="Top">
                        <Border CornerRadius="20" Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding StatusGlyph}" Style="{StaticResource IconText}" FontSize="18" HorizontalAlignment="Center" />
                        <Ellipse Style="{StaticResource StatusDot}" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource SettingTitle}" FontWeight="SemiBold" TextWrapping="Wrap"
                                   AutomationProperties.Name="Update status" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource SettingDescription}" TextWrapping="Wrap"
                                   Visibility="{Binding HasStatusDetail, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <WrapPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="420">
                        <Button Content="Check now" Command="{Binding CheckNowCommand}" Margin="0,2,8,2" AutomationProperties.Name="Check for updates now" />
                        <Button Content="What's new" Command="{Binding WhatsNewCommand}" Margin="0,2,8,2"
                                ToolTip="Release notes of the new version (or of this version on GitHub)" />
                        <Button Style="{DynamicResource AccentButtonStyle}" Content="{Binding UpdateNowLabel}" Command="{Binding UpdateNowCommand}" Margin="0,2,0,2"
                                Visibility="{Binding ShowUpdateNow, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Update now" />
                        <Button Content="Cancel" Command="{Binding CancelDownloadCommand}" Margin="0,2,0,2"
                                Visibility="{Binding ShowCancelDownload, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Cancel the download" />
                    </WrapPanel>
                </Grid>
                <ProgressBar Height="4" Margin="54,12,0,2" Value="{Binding ProgressValue, Mode=OneWay}" IsIndeterminate="{Binding ProgressIndeterminate}"
                             Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="Update progress" />
                <TextBlock Text="{Binding ErrorText}" Style="{StaticResource ErrorText}" Margin="54,8,0,0" TextWrapping="Wrap"
                           Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}" />
                <TextBlock Text="{Binding InstallNote}" Style="{StaticResource SettingDescription}" Margin="54,8,0,0" TextWrapping="Wrap"
                           Visibility="{Binding InstallNote, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
        </Border>
        <c:SettingCard Header="Check for updates automatically" Glyph="&#xE895;"
                       Description="Once a day RambiBox asks GitHub whether there's a new version, and tells you. It sends a standard request to github.com – nothing about you.">
            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Updates.CheckAutomatically}" AutomationProperties.Name="Check for updates automatically" />
        </c:SettingCard>
        <c:SettingCard Header="Install updates automatically (when you're not using the PC)" Glyph="&#xE777;"
                       Description="Off: you decide when to update. On: new versions are downloaded in the background and installed after 10 minutes without keyboard or mouse use, or while the display is off – never during a calibration. You get a notification afterwards."
                       IsEnabled="{Binding Updates.InstallAutomaticallyEnabled}">
            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Updates.InstallAutomatically}" AutomationProperties.Name="Install updates automatically" />
        </c:SettingCard>
        <c:SettingCard Header="Update channel" Glyph="&#xE7C1;"
                       Description="Stable offers releases only. Beta also offers pre-releases: new features sooner, with a higher chance of rough edges.">
            <ComboBox MinWidth="200" ItemsSource="{Binding Updates.Channels}" DisplayMemberPath="Display" SelectedValuePath="Value"
                      SelectedValue="{Binding Updates.Channel}" AutomationProperties.Name="Update channel" />
        </c:SettingCard>
        <TextBlock Style="{StaticResource SettingDescription}" Margin="2,6,0,0" TextWrapping="Wrap">
            <Run Text="&#xE72E;" FontFamily="{StaticResource IconFont}" />
            <Run Text=" Updates are downloaded from GitHub and only installed when their digital signature checks out." />
        </TextBlock>
    </StackPanel>
</UserControl>
