<Window x:Class="RambiBox.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:RambiBox.App.Controls"
        Title="RambiBox" Width="1140" Height="800" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="/Assets/RambiBox.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- navigation -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,16,0,18">
                <Image Source="/Assets/RambiBox.ico" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="RambiBox" Margin="12,0,0,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <Border Margin="10,0,0,0" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        Visibility="{Binding IsSimulated, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Started with --simulate: no real LED controller is used.">
                    <TextBlock Text="SIMULATED" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Border>
            </StackPanel>

            <!-- connection summary at the bottom of the navigation -->
            <Button DockPanel.Dock="Bottom" Margin="10,8,10,14" Padding="10,8" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0"
                    Command="{Binding NavigateCommand}" CommandParameter="device"
                    ToolTip="{Binding StatusText}" AutomationProperties.Name="Connection status">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Style="{StaticResource StatusDot}" Margin="2,0,12,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding DeviceTitle}" FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding DeviceDescription}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Button>

            <ListBox x:Name="Nav" Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource NavItem}"
                     ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                     AutomationProperties.Name="Pages">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" />
                            <TextBlock Text="{Binding Title}" Margin="14,0,0,0" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- content -->
        <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False" PanningMode="VerticalOnly">
                <StackPanel Margin="36,28,36,36" MaxWidth="1040">

                    <!-- AmbiBox still running: it holds the COM port -->
                    <c:InfoBar Severity="Warning" Title="AmbiBox is still running."
                               Message="It is using your LED controller, so RambiBox can't send colors to the LEDs."
                               Visibility="{Binding ShowAmbiBoxRunningBar, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <WrapPanel>
                                <Button Style="{DynamicResource AccentButtonStyle}" Content="{Binding CloseAmbiBoxLabel}"
                                        Command="{Binding CloseAmbiBoxCommand}" Margin="0,0,8,4" />
                                <Button Content="Remove AmbiBox from startup" Command="{Binding RemoveAmbiBoxAutostartCommand}" Margin="0,0,8,4"
                                        ToolTip="AmbiBox will no longer start when you sign in. You can undo this."
                                        Visibility="{Binding AmbiBoxInAutostart, Converter={StaticResource BoolToVisibility}}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding AmbiBoxError}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                                       Visibility="{Binding AmbiBoxError, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                    </c:InfoBar>

                    <c:InfoBar Severity="Informational" Title="AmbiBox still starts with Windows."
                               Message="It will take the LED controller again after the next restart." IsClosable="True"
                               CloseCommand="{Binding DismissAutostartBarCommand}"
                               Visibility="{Binding ShowAmbiBoxAutostartBar, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="Remove AmbiBox from startup" Command="{Binding RemoveAmbiBoxAutostartCommand}" HorizontalAlignment="Left"
                                ToolTip="AmbiBox will no longer start when you sign in. You can undo this." />
                    </c:InfoBar>

                    <c:InfoBar Severity="Success" Title="Done." Message="AmbiBox will no longer start with Windows." IsClosable="True"
                               CloseCommand="{Binding DismissAutostartRemovedCommand}"
                               Visibility="{Binding AutostartJustRemoved, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="Undo" Command="{Binding UndoAutostartCommand}" HorizontalAlignment="Left" />
                    </c:InfoBar>

                    <c:InfoBar Severity="Success" Title="Imported your AmbiBox settings:" Message="{Binding ImportSummary}" IsClosable="True"
                               CloseCommand="{Binding DismissImportCommand}"
                               Visibility="{Binding ShowImportBar, Converter={StaticResource BoolToVisibility}}" />

                    <ContentControl x:Name="PageHost" Focusable="False" IsTabStop="False" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
