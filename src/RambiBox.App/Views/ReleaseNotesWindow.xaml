<Window x:Class="RambiBox.App.Views.ReleaseNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What's new" Width="620" Height="560" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Icon="/Assets/RambiBox.ico">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource SettingDescription}" Margin="0,4,0,12" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
            <FlowDocumentScrollViewer x:Name="Viewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      IsToolBarVisible="False" Focusable="False" AutomationProperties.Name="Release notes" />
        </Border>
        <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="False">
            <Button x:Name="GitHubButton" DockPanel.Dock="Left" Click="OnOpenGitHub">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="View on GitHub" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" MinWidth="88" Click="OnClose" />
            <Button x:Name="UpdateButton" DockPanel.Dock="Right" Content="Update now" Style="{DynamicResource AccentButtonStyle}"
                    MinWidth="110" Margin="0,0,8,0" Click="OnUpdate" Visibility="Collapsed" />
        </DockPanel>
    </Grid>
</Window>
